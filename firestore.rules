rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/transcriptions/{transcriptionId} {
      allow read, delete: if isOwner(uid);
      // Écrites uniquement par le serveur (Admin SDK) après vérification du token.
      allow create, update: if false;
    }

    match /users/{uid}/usage/{period} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid}/billing/{doc} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid}/settings/{doc} {
      allow read: if isOwner(uid);
      // Seul le document "account" est modifiable, avec une liste de 10 emails max.
      allow write: if isOwner(uid)
        && doc == "account"
        && request.resource.data.keys().hasOnly(["recipients", "updatedAt"])
        && request.resource.data.recipients is list
        && request.resource.data.recipients.size() <= 10;
    }

    // Tout le reste (payments, limits, app/stripe…) : inaccessible côté client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
